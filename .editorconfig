[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true

[*.{md}]
indent_size = 2
insert_final_newline = true
max_line_length = 100

[*.{rs}]
indent_size = 2
insert_final_newline = true
max_line_length = 100

[*.{toml}]
indent_size = 2
insert_final_newline = true
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2
insert_final_newline = true
max_line_length = 100
